<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- IAppHostRunner: its code only, its build targets are the conventions of a host project. -->
    <PackageReference Include="CK.AppHost" Version="25.0.0-0.uc.4.ci.92" ExcludeAssets="build" />
    <PackageReference Include="InfiniLore.InfiniFrame" Version="0.62.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- A desktop application has no console: the host that has this package is a WinExe. -->
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>
</Project>
