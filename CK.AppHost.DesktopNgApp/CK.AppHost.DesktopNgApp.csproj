<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- The in-process endpoint ("InProcess" option): the window relays the requests of its page, no port is opened. -->
    <PackageReference Include="CK.AppIdentity.HttpEndpoint.InProcess" Version="25.0.0-0.uc.4.ci.87" />
    <!-- The "Hosting" feature of a client: the window shows the client that the endpoint serves. -->
    <PackageReference Include="CK.TS.AspNet.Clients" Version="3.0.1-0.uc.4.ci.147" />
    <!-- The "NgApp" feature of a client: the "DesktopNgApp" option is one of its options. -->
    <PackageReference Include="CK.TS.Angular" Version="3.0.1-0.uc.4.ci.130" />
    <!-- The model of the "DesktopNgApp" option. -->
    <PackageReference Include="CK.ConfigurationModel" Version="0.0.0-0.uc.2.ci.25" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CK.AppHost.Desktop\CK.AppHost.Desktop.csproj" />
    <ProjectReference Include="..\CK.IO.AppHost.Desktop\CK.IO.AppHost.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CK.AppHost.DesktopNgApp.Tests" />
  </ItemGroup>
</Project>
